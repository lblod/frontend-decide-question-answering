<BasicDropdownWormhole />
<PowerSelect
  id="local-authority"
  @options={{@localAuthorityData.localAuthorityOptions}}
  @selected={{@localAuthorityData.selectedLocalAuthority}}
  @onChange={{@onChange}}
  @searchEnabled={{false}}
  @searchField="label"
  @noMatchesMessage="No local authorities found"
  @placeholder="Select the local authority you want to ask a question about"
  as |option|
>
  {{option.label}}
</PowerSelect>
